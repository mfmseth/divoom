# Copy to `.env` and fill in. `.env` is gitignored; keep it `chmod 600`
# since it holds the Home Assistant token.
# Variables are consumed by docker-compose.yml at `up` time.

# --- Home Assistant (required) -----------------------------------------------
# Base URL of the Home Assistant instance.
HA_URL=http://10.0.0.7:8123
# Long-lived access token (HA UI -> profile -> Security -> Long-Lived Access Tokens).
HA_TOKEN=

# --- Frame targeting ---------------------------------------------------------
# IP of the Times Frame on the LAN. Setting this skips cloud discovery
# (recommended; the upstream discovery endpoint is often unreachable).
DIVOOM_FRAME_IP=
# MAC of the frame to pick during cloud discovery when you have several.
# Ignored when DIVOOM_FRAME_IP is set.
DIVOOM_FRAME_MAC=

# Timezone for the clock and date.
TZ=America/Los_Angeles

# (ADB_SERIAL picks the adb device for `divoom push` when several are
# attached. Set it in the shell that runs push, not in this file.)
